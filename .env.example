# FlowMini environment variables
# Copy this file to `.env` and fill in your key.
#
# The API key is only needed for:
#   - cleanup_mode "medium" (the optional AI rewrite / polisher)
#   - Translate-to-English polish finishing
# The default "light" cleanup mode is fully offline and needs no key.
#
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
